<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Screen Render Surface -->
    <SurfaceView
        android:id="@+id/surfaceDisplay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Disconnected / Setup State Overlay -->
    <LinearLayout
        android:id="@+id/layoutSetup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60F172A"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🖥️"
            android:textSize="56sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-black"
            android:text="ZeroDisplay"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Wireless PC Screen Mirror &amp; Touch Remote\nTouch screen to click, scroll, and drag windows."
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Host IP Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColorHint="#94A3B8"
            app:boxBackgroundColor="#1E293B"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#38BDF8">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDisplayHostIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="PC Host IP (e.g. 192.168.1.100)"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnectDisplay"
            android:layout_width="280dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-bold"
            android:text="Connect as 2nd Monitor"
            android:textAllCaps="false"
            android:textColor="#000000"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="12dp" />

        <TextView
            android:id="@+id/tvDisplayHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="💡 Ensure ZeroDisplay is enabled on ZeroLink PC (Port 8892)"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Minimal Floating HUD Bar (Visible when connected) -->
    <LinearLayout
        android:id="@+id/layoutHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_badge_pill"
        android:backgroundTint="#D9000000"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnHudBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvHudStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-bold"
            android:text="● 60 FPS"
            android:textColor="#22C55E"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvHudMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="#334155"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="Direct Touch"
            android:textColor="#E2E8F0"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnHudDisconnect"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:padding="0dp"
            android:text="Disconnect"
            android:textColor="#EF4444"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
