<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- CameraX Preview View -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Overlay: Status, Torch, Switch Camera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnCamBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="#B3000000"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvCamStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="#B3000000"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="○ Camera Ready"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnCamTorch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="#B3000000"
            android:src="@android:drawable/btn_star"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnCamSwitch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="#B3000000"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Bottom Controls Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#E60F172A"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeColor="#334155"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title & Host IP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📷 "
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="ZeroCam: PC Wireless Webcam"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Low-Latency Streaming to Discord &amp; OBS"
                        android:textColor="#9CA3AF"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCamFps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="30 FPS"
                    android:textColor="#22C55E"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColorHint="#94A3B8"
                app:boxBackgroundColor="#1E293B"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="#38BDF8">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCamHostIp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="PC Host IP (Port 8893)"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCamUsbMode"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:padding="0dp"
                    android:text="⚡ USB Cable (127.0.0.1)"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#38BDF8" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCamAutoWifi"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:padding="0dp"
                    android:text="📡 Auto-Detect Wi-Fi"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#475569" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCamStreamToggle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-bold"
                android:text="Start Webcam Stream"
                android:textAllCaps="false"
                android:textColor="#000000"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="In Discord, OBS, or Zoom: Select 'ZeroCam' or 'OBS Virtual Camera'"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
