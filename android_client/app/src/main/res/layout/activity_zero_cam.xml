<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="false"
    android:keepScreenOn="true">

    <!-- CameraX Full-Bleed Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Overlay Bar: Status, Flash, Switch Camera, Minimize Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="36dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnCamBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="#E6FFFFFF"
            android:elevation="3dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvCamStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="#E6FFFFFF"
            android:elevation="3dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="○ Camera Ready"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnCamTorch"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="#E6FFFFFF"
            android:elevation="3dp"
            android:src="@android:drawable/btn_star"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnCamSwitch"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="#E6FFFFFF"
            android:elevation="3dp"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnToggleControls"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="#E6FFFFFF"
            android:elevation="3dp"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Bottom Controls Card (Compact, Responsive, Fits on Any Phone) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#F2FFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/surface_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Row 1: Resolution Chips + Realtime FPS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRes4K"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:padding="0dp"
                    android:text="💎 4K UHD"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-bold"
                    app:backgroundTint="#111827"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRes1080p"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:padding="0dp"
                    android:text="⚡ 1080p 60F"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/surface_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRes720p"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:padding="0dp"
                    android:text="🏎️ 720p"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/surface_stroke" />

                <TextView
                    android:id="@+id/tvCamFps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="@color/surface_variant"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="30 FPS"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Row 2: Master Link Status Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/surface_variant"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCamLinkIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌁"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvCamLinkInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Linked: USB ADB (127.0.0.1:8889)"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvCamLinkBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● READY"
                    android:textColor="#10B981"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>

            <!-- Row 3: Action Buttons (Stream Toggle + OLED Standby) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCamStreamToggle"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="2"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Start Webcam Stream"
                    android:textAllCaps="false"
                    android:textColor="@color/on_primary"
                    android:textSize="12sp"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCamOledStandby"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:padding="0dp"
                    android:text="🌙 OLED Off"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/surface_stroke" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
