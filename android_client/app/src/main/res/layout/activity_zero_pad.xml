<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D13"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header: Back & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPadBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="#1E293B"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="ZeroPad"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stream Deck &amp; PC Media Remote"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPadStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="#1E293B"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="○ Disconnected"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold" />
        </LinearLayout>

        <!-- Connection Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#0F172A"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="#94A3B8"
                    app:boxBackgroundColor="#1E293B"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxStrokeColor="#38BDF8">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPadHostIp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="PC Host IP (Port 8894)"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Connection Quick Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPadUsbMode"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:padding="0dp"
                        android:text="⚡ USB (127.0.0.1)"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="#38BDF8" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPadConnect"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:padding="0dp"
                        android:text="Connect"
                        android:textColor="#000000"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-bold"
                        app:backgroundTint="#FFFFFF"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 1: Media Deck -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-bold"
            android:text="🎵 MEDIA &amp; VOLUME PLAYBACK"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:letterSpacing="0.05" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:columnCount="3"
            android:rowCount="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMediaPrev"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="⏮️\nPrev"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#1E293B"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMediaPlayPause"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="⏯️\nPlay/Pause"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#334155"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMediaNext"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="⏭️\nNext"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#1E293B"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMediaVolDown"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="🔉\nVol -"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#1E293B"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMediaMute"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="🔇\nMute"
                android:textColor="#EF4444"
                android:textSize="12sp"
                app:backgroundTint="#1E293B"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMediaVolUp"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="🔊\nVol +"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#1E293B"
                app:cornerRadius="12dp" />
        </GridLayout>

        <!-- Section 2: Streamer & Windows Macros -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-bold"
            android:text="🎙️ STREAMING &amp; WINDOWS MACROS"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:letterSpacing="0.05" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:columnCount="2"
            android:rowCount="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMacroDiscordMute"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="🎙️ Mute Discord\n(Ctrl+Shift+M)"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                app:backgroundTint="#1E293B"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMacroDiscordDeafen"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="🎧 Deafen Discord\n(Ctrl+Shift+D)"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                app:backgroundTint="#1E293B"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMacroScreenshot"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="📸 Screenshot\n(Win+Shift+S)"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                app:backgroundTint="#1E293B"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMacroDesktop"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="🖥️ Show Desktop\n(Win+D)"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                app:backgroundTint="#1E293B"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMacroTaskMgr"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="⚡ Task Manager\n(Ctrl+Shift+Esc)"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                app:backgroundTint="#1E293B"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMacroLock"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="🔒 Lock PC\n(Win+L)"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                app:backgroundTint="#1E293B"
                app:cornerRadius="12dp" />
        </GridLayout>

        <!-- Section 3: App Launchers -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-bold"
            android:text="🚀 PC APP LAUNCHERS"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:letterSpacing="0.05" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:columnCount="4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLaunchChrome"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="🌐\nChrome"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                app:backgroundTint="#1E293B"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLaunchDiscord"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="💬\nDiscord"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                app:backgroundTint="#1E293B"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLaunchExplorer"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="📁\nExplorer"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                app:backgroundTint="#1E293B"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLaunchCalc"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="🧮\nCalc"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                app:backgroundTint="#1E293B"
                app:cornerRadius="12dp" />
        </GridLayout>

    </LinearLayout>
</ScrollView>
